# ==============================================================================
# AV FLEET SAFETY & TELEMETRY AUDIT ENGINE - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env (or set these system environment variables)
# DO NOT COMMIT REAL PRODUCTION CREDENTIALS TO VERSION CONTROL
# ==============================================================================

# Database Host (use 'localhost' for local development or Student 2's OCI Public IP for remote cloud testing)
DB_HOST=localhost

# Database Port (Default MySQL port is 3306)
DB_PORT=3306

# Relational Database Name
DB_NAME=av_fleet_db

# Database Authentication Credentials
DB_USER=root
DB_PASS=your_secure_password_here
